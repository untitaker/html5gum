{"tests": [

{"description":"CR in tag preventing state change in fast_read_char (found via fuzzer)",
"input":"<a\r\"",
"output":[],
"errors":[
    {"code": "unexpected-character-in-attribute-name", "line": 1, "col": 2},
    {"code": "eof-in-tag", "line": 1, "col": 5}
]},

{"description": "CR \\u0001",
"input":"\r\u0001",
"output":[["Character","\n\u0001"]],
"errors": [
    {"code": "control-character-in-input-stream", "line": 1, "col": 2}
]},

{"description": "comment less than sign bang dash CR",
"input":"<!--<!-\r",
"output":[["Comment", "<!-\n"]],
"errors": [
    {"code": "eof-in-comment", "line": 1, "col": 5}
]},

{"description":"Mixed-case tag, attribute and DOCTYPE names are lowercased",
"input":"<!DOCTYPE HtMl><linearGradient viewBox=x></linearGradient>",
"output":[["DOCTYPE", "html", null, null, true], ["StartTag", "lineargradient", {"viewbox": "x"}], ["EndTag", "lineargradient"]]},

{"description":"Only ASCII characters in mixed-case names are lowercased",
"input":"<!DOCTYPE ÄbC><aÄbC ÖbC=x></aÄbC>",
"output":[["DOCTYPE", "Äbc", null, null, true], ["StartTag", "aÄbc", {"Öbc": "x"}], ["EndTag", "aÄbc"]]},

{"description":"Long mixed-case names with non-ASCII characters are lowercased",
